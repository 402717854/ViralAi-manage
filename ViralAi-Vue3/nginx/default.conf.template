# -----------------------------------------------------------------------------
# 由 nginx 官方镜像在启动时用 envsubst 渲染：
#   ${BACKEND_UPSTREAM} 会被替换为环境变量值（默认 server:8080）
# 注意：只使用无花括号的 nginx 变量（$uri/$host 等），它们是 nginx 自身的，
#       不会被 envsubst 处理。
# -----------------------------------------------------------------------------
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 与后端 spring.servlet.multipart.max-request-size(20MB) 对齐
    client_max_body_size 20m;

    # 前端构建已开启 gzip 预压缩（VITE_BUILD_COMPRESS=gzip），优先直接下发 .gz
    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_min_length 1k;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    # 后端接口：前端 VITE_APP_BASE_API=/prod-api，转发时去掉该前缀
    location /prod-api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        # 文件上传/下载不缓冲，避免大文件占满内存
        proxy_buffering off;
    }

    # 带 hash 的静态资源可长期缓存
    location /static/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # 单页应用路由：找不到文件一律回退 index.html
    location / {
        try_files $uri $uri/ /index.html;
        # index.html 不能缓存，否则发版后用户仍加载旧资源
        add_header Cache-Control "no-store";
    }
}
