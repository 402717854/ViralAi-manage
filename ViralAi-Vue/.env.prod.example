# 生产环境变量模板：复制为 .env.prod 后填写真实值（不要把 .env.prod 提交到仓库）
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose-prod.yml --env-file .env.prod up -d --build
#
# 注意：本文件只描述「应用如何连接外部中间件」，不会再启动 mysql / redis 容器，
# 远程实例上的库表结构、账号权限、白名单需提前准备好（可参考 sql/ 下脚本手工执行）。

# ---------------------------- 远程 MySQL ----------------------------
# 实例地址：域名 / 公网 IP / 内网 IP；若 MySQL 在 docker 宿主机上则填 host.docker.internal
DB_HOST=10.0.0.20
DB_PORT=3306
DB_NAME=ry
DB_USERNAME=ruoyi
DB_PASSWORD=change-me-db-password
# 远程实例开启了 SSL 时改为 true（云数据库常要求）
DB_USE_SSL=false

# ---------------------------- 远程 Redis ----------------------------
REDIS_HOST=10.0.0.21
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
# 建议与开发环境隔离，用独立库号
REDIS_DATABASE=0

# ---------------------------- 后端 ------------------------------
SERVER_PORT=8080
JAVA_OPTS=-Xms1024m -Xmx2048m -XX:MetaspaceSize=128m -XX:MaxMetaspaceSize=512m -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/home/ruoyi/logs -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8
# 必填：JWT 密钥，openssl rand -base64 48 生成
TOKEN_SECRET=please-change-this-token-secret-in-production
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=change-me-druid-password

# ---------------------------- 前端 ------------------------------
WEB_PORT=80
FRONTEND_DIR=../RuoYi-Vue3

# ---------------------------- 镜像 ------------------------------
# 使用镜像仓库中的成品镜像时填写，配合 up -d --no-build，生产机无需装 Maven/Node
# SERVER_IMAGE=registry.example.com/ruoyi/server:1.0.0
# WEB_IMAGE=registry.example.com/ruoyi/web:1.0.0
TAG=latest

# ---------------------------- 构建加速 --------------------------
# MAVEN_MIRROR=https://maven.aliyun.com/repository/public
NPM_REGISTRY=https://registry.npmmirror.com
