# 复制为 .env 后按需修改（docker compose 会自动读取同目录 .env）
# cp .env.example .env

# ---------------------------- 数据库 ----------------------------
# 仅在数据卷为空（首次启动）时生效，修改后需 down -v 重建才会重新初始化
MYSQL_ROOT_PASSWORD=ruoyi@2026
MYSQL_DATABASE=ry
# 需要宿主机连库时，再打开 docker-compose.yml 中 mysql 的 ports 映射
# MYSQL_PORT=3306

# ---------------------------- Redis -----------------------------
REDIS_PASSWORD=ruoyi@redis

# ---------------------------- 后端 ------------------------------
SERVER_PORT=8080
JAVA_OPTS=-Xms512m -Xmx1024m -XX:MetaspaceSize=128m -XX:MaxMetaspaceSize=512m -XX:+HeapDumpOnOutOfMemoryError -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8
# 令牌密钥，上线前务必改成随机长串（可用 openssl rand -base64 48 生成）
TOKEN_SECRET=please-change-this-token-secret-in-production
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=ruoyi@druid

# ---------------------------- 前端 ------------------------------
WEB_PORT=80
# 前端仓库位置，与 docker-compose.yml 所在目录的相对路径
FRONTEND_DIR=../RuoYi-Vue3

# ---------------------------- 构建加速 --------------------------
# 国内网络可打开，避免构建时拉依赖超时
# MAVEN_MIRROR=https://maven.aliyun.com/repository/public
NPM_REGISTRY=https://registry.npmmirror.com

# 镜像标签
TAG=latest
